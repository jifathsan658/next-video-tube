{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-video-tube",
  "main": "worker.js",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "next-video-tube",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
